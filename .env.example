# =====================================================================
#  API keys for the thesis project
#  Copy this file to ".env" (no extension) and fill in the values you
#  need. Only the scripts that actually use a given key require it.
# =====================================================================

# Google Gemini (synthetic-data generation, LLM-as-judge)
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mistral (optional, only needed for inter-judge agreement validation)
# https://console.mistral.ai/
MISTRAL_API_KEY=

# Anonymizer API (optional, only needed for the external-API baseline)
ANONYMIZER_API_KEY=
ANONYMIZER_API_URL=

# Hugging Face token is *not* set here -- run `huggingface-cli login`
# instead, which writes the token to ~/.huggingface/token.
